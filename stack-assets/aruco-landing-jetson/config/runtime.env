# ArUco hardware policy for the 12-core Jetson. Explicit caller overrides win.
export CPUS_CAMERA="${CPUS_CAMERA:-0,1}"
export CPUS_PERCEPTION="${CPUS_PERCEPTION:-2,3}"
export CPUS_ESTIMATION="${CPUS_ESTIMATION:-4}"
export CPUS_CONTROL="${CPUS_CONTROL:-5}"
export CPUS_POOL="${CPUS_POOL:-6-9}"
export CPUS_RECORDER="${CPUS_RECORDER:-10,11}"
export FLIGHT_SAFETY_RECORDER_CONFIG="${FLIGHT_SAFETY_RECORDER_CONFIG:-/work/stack-assets/aruco-landing-jetson/config/flight_safety_recorder.yaml}"

# Opt-in generic safety termination API for the dual-height landing policy.
export FLIGHT_SAFETY_ALLOW_EXTERNAL_TERMINATION="${FLIGHT_SAFETY_ALLOW_EXTERNAL_TERMINATION:-true}"

export FLIGHT_SAFETY_GEOFENCE_CONFIG="${FLIGHT_SAFETY_GEOFENCE_CONFIG:-/work/stack-assets/aruco-landing-jetson/config/geofence.yaml}"
