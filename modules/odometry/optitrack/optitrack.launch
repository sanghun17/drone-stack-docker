<launch>
  <!-- OptiTrack via VRPN. ALL params live HERE (never inline key:=val in run scripts).
       Server IP = lab mocap PC (Motive). Value comes from config/stack.env
       OPTITRACK_SERVER via optenv — edit-and-go, no rebuild.
       Topics: /vrpn_client_node/<TrackerName>/pose (one per rigid body in Motive,
       trackers auto-discovered at refresh_tracker_frequency). -->
  <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node" output="screen"
        launch-prefix="taskset -c $(env CPUS_POOL)">
    <rosparam subst_value="true">
      server: $(optenv OPTITRACK_SERVER 192.168.50.10)
      port: 3883
      update_frequency: 100.0
      frame_id: world
      <!-- Use the Jetson's receive time, NOT the mocap PC clock (hosts are not
           NTP-synced; EKF2/fast-livo consumers need stamps in local time). -->
      use_server_time: false
      broadcast_tf: true
      refresh_tracker_frequency: 1.0
    </rosparam>
  </node>
</launch>
