<?xml version="1.0"?>
<!-- Minimal runtime package so roslaunch can resolve <node pkg="d435i_tools"/>
     (paired_drop.py in this dir). run.sh prepends this dir to ROS_PACKAGE_PATH;
     nothing is catkin-built. -->
<package format="2">
  <name>d435i_tools</name>
  <version>0.1.0</version>
  <description>Helper nodes for the D435i module: stamp-matched paired 10Hz decimation
    (paired_drop.py) + lazy distance-colored cloud-on-image debug overlay (depth_overlay.py).</description>
  <maintainer email="hmcl@hmcl">hmcl</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>  <!-- Extrinsics msg (depth_overlay.py) -->
  <exec_depend>dynamic_reconfigure</exec_depend>  <!-- dynparam laser_power (d435i.launch) -->
</package>
