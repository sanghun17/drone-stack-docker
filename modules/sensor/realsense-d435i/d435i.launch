<launch>
  <!-- D435i for FAST-LIVO + voxblox on Jetson Orin (onboard USB hub).
       initial_reset  : true. The D435i motion module often enumerates (gyro/accel
                        TF frames appear) yet streams ZERO samples after an unclean
                        stop, so /camera/imu goes silent -> fast-livo sync_packages()
                        never completes -> /aft_mapped_to_init dead, even while
                        depth/color/pointcloud keep flowing. A HW reset on startup
                        clears that stuck motion module (== the "replug the camera"
                        remedy run.sh mentions, automated). Costs ~3-5s at startup.
       enable_sync    : true. Syncs ONLY the depth/color/IR VIDEO frames (cuts the
                        "No stream match for pointcloud texture" warnings). The IMU
                        is NOT synced: the motion sensor bypasses _syncer and
                        streams on its own callback (verified in realsense2_camera
                        2.3.2 base_realsense_node.cpp; IMU uses unite_imu_method,
                        separate). NOT implicated in the startup "IMU and LiDAR not
                        synced! delta: -N" storm — that storm is the uvc streamer
                        watchdog restarting the VIDEO streams (depth/color dark
                        10-25s, IMU endpoint survives) when fast-livo's nice -15
                        startup burst preempts the camera's libusb threads. Fixed
                        by CPU fencing: camera on cores 0-1 (run.sh taskset),
                        fast-livo on 2-3 (mapping_d435i.launch launch-prefix).
                        Verified with sync=true + an independent rostopic delay
                        probe: steady 130ms, no growth, 10.0Hz.
       allow_no_texture_points : keep publishing points even without a color match
       All params live HERE, not on the roslaunch command line. -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="depth_width"             value="640"/>
    <arg name="depth_height"            value="480"/>
    <arg name="depth_fps"               value="15"/>
    <arg name="color_width"             value="640"/>
    <arg name="color_height"            value="480"/>
    <arg name="color_fps"               value="15"/>
    <arg name="enable_gyro"             value="true"/>
    <arg name="enable_accel"            value="true"/>
    <arg name="unite_imu_method"        value="linear_interpolation"/>
    <arg name="initial_reset"           value="true"/>  <!-- HW-reset on start: wakes the stuck D435i motion module so /camera/imu actually streams -->
    <!-- decimation 3x: ON (was OFF). Full-res pointcloud is ~66ms/frame — right at
         the 67ms 15fps budget; in the OptiTrack volume the per-frame time spikes
         over it -> color frames back up -> the color UVC stream starves and dies
         (watchdog on EP132; depth/IMU survive). decim 3x caps pointcloud at ~18ms
         (verified back-to-back IN the volume: full-res DIE@27s vs decim SURVIVE)
         and drops density to ~Mid-360 1s-cumulative (~7 pts/deg^2). fast-livo
         already thins via point_filter_num:10. magnitude=3 set by the
         set_decimation dynparam node below (rs_camera.launch has no arg for it).
         spatial: edge-preserving depth speckle smoothing. temporal: OFF — trails
         ghosts on a moving platform. -->
    <arg name="filters"                 value="decimation,spatial,pointcloud"/>
    <arg name="allow_no_texture_points" value="true"/>
    <arg name="enable_sync"             value="true"/>
    <arg name="clip_distance"           value="10.0"/>  <!-- max range 10m (standard config). NOTE: D435i depth noise grows ~dist^2, so >~6m is noisy — was 6.0, raised to the standard 10m per use -->
  </include>

  <!-- ===== 10Hz decimation shared by fast-livo (odom) + voxblox (mapping) =====
       D435i has no native 10fps mode (only 6/15/30/60/90), so the camera runs at
       15Hz and we decimate to 10Hz HERE, once, for both consumers.
       paired_drop.py (pkg d435i_tools, this dir) pairs image+cloud BY HEADER
       STAMP first, then ONE counter keeps 2 of every 3 PAIRS -> 15*2/3 = 10.0Hz
       (mean; spacing alternates ~67/133ms since 10 isn't an even divisor of 15).
       Header stamps pass through untouched, so fast-livo's odom stamp ==
       voxblox's cloud stamp -> exact TF lookup match, no "queue too long" drops.
       WHY NOT two `topic_tools drop 1 3` relays (previous setup): drop is a
       per-message COUNTER, so each relay's surviving frame subset depends on
       which frame it happened to see first after a (re)start. When the two
       phases land misaligned (random, e.g. the uvc watchdog restarting the
       video streams) the topics share only 1-in-3 frames -> fast-livo odom at
       exactly 5Hz + endless "No point!!!". One counter over PAIRS makes the two
       outputs carry the same frame subset by construction.
       WHY NOT `throttle messages 10`: its "publish if elapsed >= 1/rate" rule
       on a 15Hz source keeps every OTHER frame -> only 7.5Hz.
       IMU stays full-rate (~200Hz) on /camera/imu: high IMU rate fills the gaps
       between the slower 10Hz lidar/image frames (propagation). -->
  <node pkg="d435i_tools" type="paired_drop.py" name="paired_drop_10hz" output="screen"
        launch-prefix="taskset -c $(env CPUS_POOL)">
    <!-- launch-prefix moves this relay (~0.2 core, nice 0) OUT of the camera fence
         it would inherit from run.sh's taskset: cores 0-1 stay EXCLUSIVE to the
         driver's libusb/uvc threads (uvc watchdog protection). -->
    <param name="keep"  value="2"/>
    <param name="every" value="3"/>
    <param name="slop"  value="0.025"/>  <!-- pair if |stamp diff| <= 25ms (frames are 67ms apart) -->
    <remap from="image_in"  to="/camera/color/image_raw"/>
    <remap from="image_out" to="/camera/color/image_raw_10hz"/>
    <remap from="cloud_in"  to="/camera/depth/color/points"/>
    <remap from="cloud_out" to="/camera/depth/color/points_10hz"/>
  </node>

  <!-- IR emitter at max power (default 150/360): denser projector pattern ->
       better stereo matching indoors. dynparam blocks until the driver's
       reconfigure server is up, sets the value once, exits (exit is fine:
       the node is not required). Power draw is irrelevant here. -->
  <node pkg="dynamic_reconfigure" type="dynparam" name="set_laser_power"
        args="set /camera/stereo_module laser_power 360"/>

  <!-- High Accuracy depth preset (default 0=Custom): raises the matcher confidence
       threshold so low-confidence pixels are dropped -> kills frame-to-frame speckle
       AND the edge "flying pixel" shadows that get carved into voxblox as fake walls.
       Cost: sparser cloud / more holes. Does NOT touch laser_power (verified live).
       No arg in rs_camera.launch -> set via dynparam, same blocks-until-ready pattern. -->
  <node pkg="dynamic_reconfigure" type="dynparam" name="set_visual_preset"
        args="set /camera/stereo_module visual_preset 3"/>

  <!-- decimation magnitude 3 (default 2): 640x480 -> 213x160, ~1/9 points ->
       pointcloud ~18ms, density ~Mid-360. Same dynparam-blocks-until-ready pattern
       as set_laser_power. The "decimation" filter must be in <filters> above. -->
  <node pkg="dynamic_reconfigure" type="dynparam" name="set_decimation"
        args="set /camera/decimation filter_magnitude 3"/>

  <!-- Depth-noise debug view: cloud projected on the color image, distance-
       colored (red=near) -> /camera/depth_overlay. Computes NOTHING until
       someone subscribes (1s poll), so it is free to keep launched here.
       Off the camera cores for the same reason as paired_drop above. -->
  <node pkg="d435i_tools" type="depth_overlay.py" name="depth_overlay" output="screen"
        respawn="true" launch-prefix="taskset -c $(env CPUS_POOL)">
    <!-- respawn: lets us apply new params live (rosparam set + kill -> fresh read) -->
    <param name="range_min" value="0.3"/>
    <param name="range_max" value="6.0"/>  <!-- match clip_distance -->
    <param name="point_px"     value="2"/>    <!-- 2x2 dots, but alpha-blended (1px too faint, opaque 2x2 hid the RGB) -->
    <param name="alpha"        value="0.55"/>
    <param name="point_stride" value="2"/>    <!-- every 2nd point: keeps cb < 100ms/frame -->
    <remap from="image_in"    to="/camera/color/image_raw_10hz"/>
    <remap from="cloud_in"    to="/camera/depth/color/points_10hz"/>
    <remap from="image_out"   to="/camera/depth_overlay"/>
    <remap from="camera_info" to="/camera/color/camera_info"/>
    <remap from="extrinsics"  to="/camera/extrinsics/depth_to_color"/>
  </node>
</launch>
