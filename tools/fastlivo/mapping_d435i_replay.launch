<launch>
  <!-- FAST-LIVO2 OPEN-LOOP replay: run the odometry node against a recorded bag
       (no camera, no flight). Driven by tools/fastlivo/replay_fastlivo.sh, which
       starts this launch, then plays the bag with rosbag clock publishing.

       use_sim_time remains mandatory for timers/TF and every auxiliary node to
       share the bag clock.  Sensor-epoch estimator outputs themselves are
       stamped from last_lio_update_time so callback latency cannot move a pose
       along the evaluation timeline. -->
  <param name="/use_sim_time" value="true"/>

  <!-- swap in an edited copy to A/B a calibration change (extrinsics / time_offset /
       imu cov) without rebuilding, via replay_fastlivo.sh config:=<file> -->
  <arg name="config"     default="$(find fast_livo)/config/d435i.yaml"/>
  <!-- Optional sparse override loaded AFTER the complete production config.
       This keeps A/B files tiny and prevents a candidate from accidentally
       omitting a production parameter. -->
  <arg name="overlay"    default=""/>
  <arg name="cam_calib"  default="$(find fast_livo)/config/camera_d435i.yaml"/>
  <!-- true: bag holds RAW /camera/color/image_raw + /camera/depth/color/points,
       regenerate the 10Hz pair here (identical to the live d435i.launch decimation).
       false (default): bag already holds the *_10hz topics fast-livo consumes. -->
  <arg name="paired_drop" default="false"/>
  <!-- off by default: in analysis we WANT to see a divergence, not kill the node. -->
  <arg name="odom_guard"  default="false"/>
  <arg name="visual_quality_log" default="false"/>
  <arg name="visual_quality_output_prefix" default="/tmp/fast_livo_visual_quality"/>
  <arg name="mocap_anchor_enable" default="true"/>

  <node pkg="tf" type="static_transform_publisher" name="odom_to_camera_init"
        args="0 0 0 0.5 -0.5 0.5 -0.5 odom camera_init 100"/>

  <rosparam command="load" file="$(arg config)"/>
  <group if="$(eval arg('overlay') != '')">
    <rosparam command="load" file="$(arg overlay)"/>
  </group>
  <!-- REPLAY FIX: force static intrinsics. The online path does
       ros::topic::waitForMessage<CameraInfo>(.., ros::Duration(5s)) in the LIVMapper
       ctor BEFORE /aft_mapped_to_init is advertised. That timeout is measured on the
       ROS clock (sim time), and the harness gates rosbag-play (the only /clock source)
       on that advertise -> frozen clock -> the 5s wait never elapses -> deadlock.
       In replay no CameraInfo is ever published anyway, so this always fell back to
       cam_calib (camera_d435i.yaml); disabling it just skips the deadlocking wait. -->
  <param name="common/online_intrinsics_en" value="false"/>
  <param name="common/cam_calib_file" value="$(arg cam_calib)"/>
  <param name="debug/verbose" value="false"/>
  <param name="debug/visual_quality_log" value="$(arg visual_quality_log)"/>
  <param name="debug/visual_quality_output_prefix"
         value="$(arg visual_quality_output_prefix)"/>
  <param name="mocap/anchor_enable" value="$(arg mocap_anchor_enable)"/>

  <!-- no taskset/nice: offline replay is not competing with a live camera, so the
       CPU-fence rationale from mapping_d435i.launch does not apply. -->
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <!-- REPLAY FIX (cont.): online_intrinsics is off above, so the ctor's fallback that
         did `rosparam load cam_calib /laserMapping` no longer runs. Load the static
         intrinsics into this node's private ns here so loadFromRosNs("laserMapping") finds
         cam_model/cam_fx/... — identical to the intrinsics the online path always fell back
         to in replay (no CameraInfo on the bag). -->
    <rosparam command="load" file="$(arg cam_calib)"/>
  </node>

  <node pkg="fast_livo" type="smart_static_tf_bridge.py" name="smart_tf_bridge" output="log">
    <rosparam param="bridges">
      - {parent: aft_mapped, child: camera_imu_optical_frame}
    </rosparam>
  </node>

  <group if="$(arg paired_drop)">
    <node pkg="d435i_tools" type="paired_drop.py" name="paired_drop_10hz" output="screen">
      <param name="keep"  value="2"/>
      <param name="every" value="3"/>
      <param name="slop"  value="0.025"/>
      <remap from="image_in"  to="/camera/color/image_raw"/>
      <remap from="image_out" to="/camera/color/image_raw_10hz"/>
      <remap from="cloud_in"  to="/camera/depth/color/points"/>
      <remap from="cloud_out" to="/camera/depth/color/points_10hz"/>
    </node>
  </group>

  <group if="$(arg odom_guard)">
    <node pkg="fast_livo" type="odom_guard.py" name="odom_guard" output="screen">
      <param name="max_dist" value="100.0"/>
      <param name="kill_node" value="/laserMapping"/>
      <param name="enabled" value="true"/>
    </node>
  </group>
</launch>
