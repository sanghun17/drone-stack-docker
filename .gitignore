# generated by setup.sh (per-stack Dockerfile + compose)
.build/
*.generated.yml
Dockerfile.*.generated

# per-module catkin workspaces under ws/<module>/ — src/ populated by `setup.sh clone`
# (component repos, own git), build/devel local. Whole ws/ gitignored; clone recreates.
/ws/

# NOTE: modules/compute/jax/wheels/*.whl IS tracked (the reused jaxlib artifact —
# avoids the multi-hour jaxlib-from-source rebuild). Intentionally NOT ignored.

# ROS / build artifacts
build/
devel/
logs/
__pycache__/
*.pyc
*.pyo

# editor / os
.vscode/
.idea/
.nfs*
