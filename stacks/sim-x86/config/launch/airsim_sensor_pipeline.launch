<launch>
  <!-- Image acquisition, camera metadata and TF belong to simulation/airsim.
       This stack composes the existing odometry relay and ROS depth processing. -->
  <arg name="localization"/>
  <arg name="publish_range_rays" default="false"/>
  <param name="use_sim_time" value="true"/>
  <node name="clock_relay" pkg="topic_tools" type="relay" args="/airsim_node/clock /clock --wait-for-start"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 1 map odom"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="imu_to_base" args="0 0 0 0 0 0 1 imu base_link"
        unless="$(eval arg('localization') == 'vio')"/>
  <node pkg="active_3d_planning_app_reconstruction" type="airsim_gt_odom_publisher.py"
        name="airsim_gt_odom_publisher" output="screen" launch-prefix="python3" required="true"/>
  <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager" required="true"/>
  <node pkg="nodelet" type="nodelet" name="nodelet_depth_xyz" args="load depth_image_proc/point_cloud_xyz nodelet_manager">
    <remap from="camera_info" to="/camera/depth/camera_info"/>
    <remap from="image_rect" to="/camera/depth/image_raw"/>
    <remap from="points" to="/camera/depth/image_raw/points"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="pcl_manager" args="manager" required="true"/>
  <node pkg="nodelet" type="nodelet" name="voxel_grid" args="load pcl/VoxelGrid pcl_manager">
    <remap from="~input" to="/camera/depth/image_raw/points"/>
    <rosparam>
      filter_field_name: z
      filter_limit_min: 0.1
      filter_limit_max: 5.1
      filter_limit_negative: false
      leaf_size: 0.07
    </rosparam>
  </node>
  <!-- Range-limited occupancy mappers need distant surface returns to clear
       free space up to their own maximum range. Keep the bounded feature
       cloud above for existing estimator consumers. -->
  <node pkg="nodelet" type="nodelet" name="voxel_grid_rays"
        args="load pcl/VoxelGrid pcl_manager" if="$(arg publish_range_rays)">
    <remap from="~input" to="/camera/depth/image_raw/points"/>
    <remap from="~output" to="/voxel_grid/rays"/>
    <rosparam>
      filter_field_name: z
      filter_limit_min: 0.1
      filter_limit_max: 1000000000.0
      filter_limit_negative: false
      leaf_size: 0.07
    </rosparam>
  </node>
</launch>
