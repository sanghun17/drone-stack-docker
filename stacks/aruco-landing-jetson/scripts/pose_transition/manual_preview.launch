<launch>
  <!-- This launch has no MAVROS output. The existing flight-safety MUX stays mocap. -->
  <include file="$(find aruco_landing)/launch/landing_vision_pose_adapter.launch">
    <arg name="output_topic" value="/landing/vision_pose_selected"/>
    <arg name="allow_marker_switch" value="true"/>
    <arg name="auto_switch" value="true"/>
    <arg name="auto_fallback_to_optitrack" value="true"/>
    <arg name="marker_loss_timeout_s" value="0.5"/>
  </include>
  <node launch-prefix="taskset -c $(env CPUS_ESTIMATION)" pkg="aruco_landing" type="manual_flight_preview.py" name="manual_flight_preview" output="screen" required="true">
    <param name="extrinsic_file" value="/work/stacks/aruco-landing-jetson/config/calibration/20260919/base_link_to_see3cam_optical_frame.yaml"/>
  </node>
  <rosparam file="$(find aruco_landing)/config/common_experiment.yaml" ns="landing_preview_optitrack"/>
  <node launch-prefix="taskset -c $(env CPUS_CONTROL)" pkg="aruco_landing" type="landing_controller_node.py" name="landing_preview_optitrack" output="screen" required="true">
    <param name="enabled" value="true"/>
    <param name="preview_only" value="true"/>
    <param name="vehicle_pose_topic" value="/landing/shadow/optitrack/vehicle_pose_pad"/>
    <param name="camera_pose_topic" value="/landing/shadow/optitrack/camera_pose_pad"/>
    <param name="target_visible_topic" value="/landing/shadow/optitrack/valid"/>
    <param name="command_topic" value="/landing/shadow/optitrack/cmd_vel_pad"/>
    <remap from="/landing/yaw_cmd" to="/landing/shadow/optitrack/yaw_cmd"/>
    <remap from="/landing/yaw_error" to="/landing/shadow/optitrack/yaw_error"/>
    <remap from="/landing/controller/active" to="/landing/shadow/optitrack/controller/active"/>
    <remap from="/landing/controller/abort" to="/landing/shadow/optitrack/controller/abort"/>
    <remap from="/landing/controller/touchdown" to="/landing/shadow/optitrack/controller/touchdown"/>
    <remap from="/landing/controller/state" to="/landing/shadow/optitrack/controller/state"/>
  </node>
  <rosparam file="$(find aruco_landing)/config/common_experiment.yaml" ns="landing_preview_transition"/>
  <node launch-prefix="taskset -c $(env CPUS_CONTROL)" pkg="aruco_landing" type="landing_controller_node.py" name="landing_preview_transition" output="screen" required="true">
    <param name="enabled" value="true"/>
    <param name="preview_only" value="true"/>
    <param name="vehicle_pose_topic" value="/landing/shadow/transition/vehicle_pose_pad"/>
    <param name="camera_pose_topic" value="/landing/shadow/transition/camera_pose_pad"/>
    <param name="target_visible_topic" value="/landing/shadow/transition/valid"/>
    <param name="command_topic" value="/landing/shadow/transition/cmd_vel_pad"/>
    <remap from="/landing/yaw_cmd" to="/landing/shadow/transition/yaw_cmd"/>
    <remap from="/landing/yaw_error" to="/landing/shadow/transition/yaw_error"/>
    <remap from="/landing/controller/active" to="/landing/shadow/transition/controller/active"/>
    <remap from="/landing/controller/abort" to="/landing/shadow/transition/controller/abort"/>
    <remap from="/landing/controller/touchdown" to="/landing/shadow/transition/controller/touchdown"/>
    <remap from="/landing/controller/state" to="/landing/shadow/transition/controller/state"/>
  </node>
  <node launch-prefix="taskset -c $(env CPUS_POOL)" pkg="aruco_landing" type="manual_flight_audit.py" name="manual_flight_audit" output="screen" required="true"/>
</launch>
