# ArUco hardware policy for the 12-core Jetson. CPU caller overrides win.
export CPUS_CAMERA="${CPUS_CAMERA:-0,1}"
export CPUS_PERCEPTION="${CPUS_PERCEPTION:-2,3}"
export CPUS_ESTIMATION="${CPUS_ESTIMATION:-4}"
export CPUS_CONTROL="${CPUS_CONTROL:-5}"
export CPUS_POOL="${CPUS_POOL:-6-9}"
export CPUS_RECORDER="${CPUS_RECORDER:-10,11}"

# ArUco pose-router policy. This configures its candidate output; the shared
# flight-safety MUX forwards this candidate using its generic external input.
# Override legacy false values baked into existing containers without recreating
# running modules. Explicit roslaunch arguments to the router still override.
export LANDING_ALLOW_MARKER_SWITCH=true
export LANDING_AUTO_SWITCH=true
export LANDING_AUTO_FALLBACK_TO_OPTITRACK=true
export LANDING_MARKER_LOSS_TIMEOUT_S=0.5
export FLIGHT_SAFETY_RECORDER_CONFIG="${FLIGHT_SAFETY_RECORDER_CONFIG:-/work/stacks/aruco-landing-jetson/config/flight_safety_recorder.yaml}"

# Opt-in generic safety termination API for the dual-height landing policy.
export FLIGHT_SAFETY_ALLOW_EXTERNAL_TERMINATION="${FLIGHT_SAFETY_ALLOW_EXTERNAL_TERMINATION:-true}"

export FLIGHT_SAFETY_GEOFENCE_CONFIG="${FLIGHT_SAFETY_GEOFENCE_CONFIG:-/work/stacks/aruco-landing-jetson/config/geofence.yaml}"

# Stack-owned routing: the common safety module accepts generic source/topic options.
export LANDING_REQUIRE_TRIAL_ENABLE=true
export LANDING_REJECT_INCONSISTENT_MARKER=true
export FLIGHT_SAFETY_ESTIMATION_SOURCE=external
export FLIGHT_SAFETY_EXTERNAL_POSE_TOPIC=/landing/vision_pose_selected

# Canonical planner entrypoint: prepare before takeoff; only a new pilot OFFBOARD
# edge starts motion. The ROS launch file itself retains observation defaults.
export LANDING_TRIAL_AUTO_START="${LANDING_TRIAL_AUTO_START:-true}"
export LANDING_TRIAL_DRY_RUN="${LANDING_TRIAL_DRY_RUN:-false}"

# Keep approach slow; match AirSim command limits after descent qualification.
export LANDING_APPROACH_SPEED_MPS=0.5
export LANDING_HORIZONTAL_SPEED_MPS=2.0
export LANDING_DESCENT_SPEED_MPS=0.5

# ArUco-only consistency limits; other stacks retain common defaults.
export FLIGHT_SAFETY_CONSISTENCY_CONFIG="${FLIGHT_SAFETY_CONSISTENCY_CONFIG:-/work/stacks/aruco-landing-jetson/config/consistency.yaml}"
