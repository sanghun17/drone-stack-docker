Panels:
- Class: rviz/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: see3cam_optical_frame
    Frame Rate: 20
  Displays:
  - Class: rviz/Image
    Name: Original
    Enabled: true
    Image Topic: /landing/camera/image_color
    Transport Hint: raw
    Queue Size: 1
    Normalize Range: true
  - Class: rviz/Image
    Name: Undistorted
    Enabled: true
    Image Topic: /landing/camera/image_rect_color
    Transport Hint: raw
    Queue Size: 1
    Normalize Range: true
  Enabled: true
  Tools:
  - Class: rviz/Interact
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2
Window Geometry:
  Width: 1580
  Height: 860
  X: 0
  Y: 0
  QMainWindow State: 
