+#if PLATFORM_LINUX
+bool FRecordingThread::initializeMmap(const ImageCaptureBase::ImageResponse& response)
+{
+    if (mmap_address_) return true;
+    if (response.width <= 0 || response.height <= 0 || response.image_data_uint8.empty()) return false;
+
+    const std::size_t data_bytes = response.image_data_uint8.size();
+    mmap_size_ = kLandingMmapHeaderBytes + kLandingMmapSlots * data_bytes;
+    mmap_fd_ = ::open(mmap_path_.c_str(), O_CREAT | O_RDWR | O_TRUNC, 0666);
+    if (mmap_fd_ < 0 || ::ftruncate(mmap_fd_, static_cast<off_t>(mmap_size_)) != 0) {
+        UE_LOG(LogTemp, Error, TEXT("Unable to create landing camera mmap: %s"), UTF8_TO_TCHAR(mmap_path_.c_str()));
+        closeMmap();
+        return false;
+    }
+    mmap_address_ = ::mmap(nullptr, mmap_size_, PROT_READ | PROT_WRITE, MAP_SHARED, mmap_fd_, 0);
+    if (mmap_address_ == MAP_FAILED) {
+        mmap_address_ = nullptr;
+        UE_LOG(LogTemp, Error, TEXT("Unable to map landing camera file: %s"), UTF8_TO_TCHAR(mmap_path_.c_str()));
+        closeMmap();
+        return false;
+    }
+
+    std::memset(mmap_address_, 0, mmap_size_);
+    auto* header = static_cast<LandingMmapHeader*>(mmap_address_);
+    header->magic = kLandingMmapMagic;
+    header->version = kLandingMmapVersion;
+    header->header_bytes = kLandingMmapHeaderBytes;
+    header->width = static_cast<std::uint32_t>(response.width);
+    header->height = static_cast<std::uint32_t>(response.height);
+    header->stride = static_cast<std::uint32_t>(data_bytes / response.height);
+    header->data_bytes = static_cast<std::uint32_t>(data_bytes);
+    header->slot_count = kLandingMmapSlots;
+    __atomic_store_n(&header->sequence, 0ULL, __ATOMIC_RELEASE);
+    UE_LOG(LogTemp, Display, TEXT("Landing camera mmap ready: %s (%dx%d, %d bytes)"),
+           UTF8_TO_TCHAR(mmap_path_.c_str()), response.width, response.height, static_cast<int>(data_bytes));
+    return true;
+}
+
+void FRecordingThread::appendMmap(const ImageCaptureBase::ImageResponse& response)
+{
+    if (!initializeMmap(response)) return;
+    auto* header = static_cast<LandingMmapHeader*>(mmap_address_);
+    if (response.image_data_uint8.size() != header->data_bytes ||
+        response.width != static_cast<int>(header->width) ||
+        response.height != static_cast<int>(header->height)) return;
+
+    const std::uint64_t odd = mmap_sequence_ + 1;
+    const std::uint64_t even = mmap_sequence_ + 2;
+    const std::uint32_t slot = static_cast<std::uint32_t>((even / 2) % kLandingMmapSlots);
+    __atomic_store_n(&header->sequence, odd, __ATOMIC_RELEASE);
+    auto* destination = static_cast<std::uint8_t*>(mmap_address_) +
+                        kLandingMmapHeaderBytes + slot * header->data_bytes;
+    std::memcpy(destination, response.image_data_uint8.data(), header->data_bytes);
+    header->active_slot = slot;
+    header->timestamp_ns = response.time_stamp;
+    header->camera_position[0] = response.camera_position.x();
+    header->camera_position[1] = response.camera_position.y();
+    header->camera_position[2] = response.camera_position.z();
+    header->camera_orientation_xyzw[0] = response.camera_orientation.x();
+    header->camera_orientation_xyzw[1] = response.camera_orientation.y();
+    header->camera_orientation_xyzw[2] = response.camera_orientation.z();
+    header->camera_orientation_xyzw[3] = response.camera_orientation.w();
+    __atomic_store_n(&header->sequence, even, __ATOMIC_RELEASE);
+    mmap_sequence_ = even;
+}
+
+void FRecordingThread::closeMmap()
+{
+    if (mmap_address_) {
+        ::munmap(mmap_address_, mmap_size_);
+        mmap_address_ = nullptr;
+    }
+    if (mmap_fd_ >= 0) {
+        ::close(mmap_fd_);
+        mmap_fd_ = -1;
+    }
+}
+#endif
