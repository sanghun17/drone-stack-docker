 #include "Engine/TextureRenderTarget2D.h"
 #include "Async/TaskGraphInterfaces.h"
 #include "ImageUtils.h"
+#include "RHIGPUReadback.h"

 #include "AirBlueprintLib.h"
 #include "Async/Async.h"

+#include <array>
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+struct LandingReadbackSlot
+{
+    TUniquePtr<FRHIGPUTextureReadback> readback;
+    bool pending = false;
+    uint64 ticket = 0;
+    FIntPoint size = FIntPoint::ZeroValue;
+};
+
+struct LandingReadbackState
+{
+    std::array<LandingReadbackSlot, 3> slots;
+    uint64 next_ticket = 1;
+};
+
+// Accessed only by the render thread. Intentionally process-lifetime storage:
+// destroying GPU readback objects after RHI shutdown is unsafe on UE4.27.
+static std::unordered_map<const void*, LandingReadbackState*> landing_readbacks;
+static std::mutex landing_result_mutex;
+static std::unordered_map<const void*, std::shared_ptr<RenderRequest::RenderResult>>
+    landing_results;
+
+bool readSurfaceDataAsync(FRHICommandListImmediate& RHICmdList,
+                          const FTexture2DRHIRef& texture,
+                          RenderRequest::RenderResult* result,
+                          const FIntPoint& size)
+{
+    auto*& state_ptr = landing_readbacks[texture.GetReference()];
+    if (!state_ptr) state_ptr = new LandingReadbackState();
+    LandingReadbackState& state = *state_ptr;
+
+    LandingReadbackSlot* ready = nullptr;
+    for (auto& slot : state.slots) {
+        if (slot.pending && slot.readback->IsReady() &&
+            (!ready || slot.ticket < ready->ticket)) {
+            ready = &slot;
+        }
+    }
+
+    bool produced = false;
+    if (ready) {
+        void* source = nullptr;
+        int32 row_pitch_pixels = 0;
+        ready->readback->LockTexture(RHICmdList, source, row_pitch_pixels);
+        if (source && row_pitch_pixels >= ready->size.X) {
+            result->width = ready->size.X;
+            result->height = ready->size.Y;
+            result->bmp.SetNumUninitialized(result->width * result->height, false);
+            const uint8* source_bytes = static_cast<const uint8*>(source);
+            uint8* destination = reinterpret_cast<uint8*>(result->bmp.GetData());
+            for (int32 row = 0; row < result->height; ++row) {
+                FMemory::Memcpy(destination + row * result->width * sizeof(FColor),
+                                source_bytes + row * row_pitch_pixels * sizeof(FColor),
+                                result->width * sizeof(FColor));
+            }
+            produced = true;
+        }
+        ready->readback->Unlock();
+        ready->pending = false;
+    }
+
+    LandingReadbackSlot* free_slot = nullptr;
+    for (auto& slot : state.slots) {
+        if (!slot.pending) {
+            free_slot = &slot;
+            break;
+        }
+    }
+    if (free_slot) {
+        if (!free_slot->readback) {
+            free_slot->readback.Reset(new FRHIGPUTextureReadback(TEXT("LandingCameraReadback")));
+        }
+        free_slot->size = size;
+        free_slot->ticket = state.next_ticket++;
+        free_slot->readback->EnqueueCopy(RHICmdList, texture);
+        // FRHIGPUTextureReadback's non-RDG EnqueueCopy leaves the source in
+        // CopySrc. The same render target is sampled by AirSim's visible
+        // subwindow on the following frame, so restore a shader-readable
+        // access state explicitly. Without this transition Vulkan reports an
+        // invalid transfer-source image layout and periodically stalls.
+        RHICmdList.Transition(
+            FRHITransitionInfo(texture, ERHIAccess::CopySrc, ERHIAccess::SRVMask));
+        free_slot->pending = true;
+    }
+    return produced;
+}
+}
