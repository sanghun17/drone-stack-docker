# Resolve storage relative to this checkout on both host and /work in Docker.
export DSD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DSD_DATA_ROOT="${DSD_DATA_ROOT:-$DSD_ROOT/data}"
export SIM_RISK_AWARE_ASSETS="${SIM_RISK_AWARE_ASSETS:-$DSD_DATA_ROOT/assets}"
export RISK_AWARE_ASSETS="${RISK_AWARE_ASSETS:-$DSD_DATA_ROOT/assets}"
export ARUCO_LANDING_PACKAGE_DIR="${ARUCO_LANDING_PACKAGE_DIR:-$DSD_DATA_ROOT/assets/simulator/package}"
