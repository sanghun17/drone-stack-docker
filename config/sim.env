# ─────────────────────────────────────────────────────────────────────────
# sim ROS networking override — sourced by sim-x86 run scripts BEFORE
# config/ros_env.sh (whose defaults are the jetson-deploy values). Overrides
# ROS_MASTER_HOST/ROS_IP/ROS_HOSTNAME via env, which config/ros_env.sh now
# honors (${VAR:-default}) instead of clobbering — see that file's header.
#
# The AirSim/UE4 sim (roscore + UE4 + airsim_node) lives on the HOST, whose LAN
# IP is 192.168.50.12 (this desktop) — NOT 127.0.0.1: the container reaches the
# host's roscore over network_mode:host at this address, and other machines
# subscribing to sim topics need a real advertised URI, not loopback.
# ─────────────────────────────────────────────────────────────────────────
export ROS_MASTER_HOST=192.168.50.12
export ROS_IP=192.168.50.12
export ROS_HOSTNAME=192.168.50.12
