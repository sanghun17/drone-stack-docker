source "${BASH_SOURCE[0]%/*}/project.env"
# ─────────────────────────────────────────────────────────────────────────
# sim ROS networking override — sourced by sim-x86 run scripts BEFORE
# config/ros_env.sh (whose defaults are the jetson-deploy values). Overrides
# ROS_MASTER_HOST/ROS_IP/ROS_HOSTNAME via env, which config/ros_env.sh now
# honors (${VAR:-default}) instead of clobbering — see that file's header.
#
# The AirSim/UE4 sim (roscore + UE4 + airsim_node) lives on the HOST, whose LAN
# IP is 192.168.50.12 (this desktop) — NOT 127.0.0.1: the container reaches the
# host's roscore over network_mode:host at this address, and other machines
# subscribing to sim topics need a real advertised URI, not loopback.
# ─────────────────────────────────────────────────────────────────────────
export ROS_MASTER_HOST=192.168.50.12
export ROS_IP=192.168.50.12
export ROS_HOSTNAME=192.168.50.12

# VFE/uncertainty 체크포인트 위치 — voxblox tsdf_integrator.cc가 이 env를 1순위로
# 읽고, 없으면 $HOME/risk_aware_assets/checkpoints 로 fallback 한다. 컨테이너는
# HOME=/root 라 fallback이 깨짐 (2026-07-25 검증② 실증: sparse_vfe_traced.pt open
# 실패로 voxblox/exploration SIGABRT). 마운트는 호스트 동일 절대경로이므로 명시 지정.
export RISK_AWARE_CHECKPOINTS=${DSD_DATA_ROOT}/assets/checkpoints

# GT PLY (runtime_evaluator gt_ply_path의 optenv 1순위) — 같은 HOME fallback 계열.
export RISK_AWARE_GT_DIR=${DSD_DATA_ROOT}/assets/gt

# Canonical host-side AirSim/Unreal asset layout. These paths are also visible
# in the sim container because SIM_RISK_AWARE_ASSETS is bind-mounted at the
# same absolute location. Host bring-up scripts use the same defaults.
export RISK_AWARE_SIM_ASSETS=${DSD_DATA_ROOT}/assets/simulation
export AIRSIM_ROOT=${DSD_DATA_ROOT}/assets/simulation/airsim/AirSim_vanila
export AIRSIM_SETTINGS_DIR=${DSD_DATA_ROOT}/assets/simulation/airsim/user_data
export UE_PACKAGED_ROOT=${DSD_DATA_ROOT}/assets/simulation/unreal/packaged
export UE_EDITOR_ROOT=${DSD_DATA_ROOT}/assets/simulation/unreal/editor

# Built ArUco simulator is a reusable runtime asset; captures remain flight_logs.
export ARUCO_LANDING_PACKAGE_DIR="${ARUCO_LANDING_PACKAGE_DIR:-${DSD_DATA_ROOT}/assets/simulator/package}"
