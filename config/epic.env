# ─────────────────────────────────────────────────────────────────────────
# EPIC stack env override — sourced by planner/epic run scripts (via
# modules/planner/epic/_enter.sh) BEFORE config/ros_env.sh, whose defaults are
# the Jetson-deploy values. ros_env.sh honors ${VAR:-default}, so exporting here
# overrides without touching the jetson values.
# ─────────────────────────────────────────────────────────────────────────

# EPIC runs self-contained on ONE machine: roscore, all nodes and RViz live in
# the same container (network_mode:host). So the master is localhost — unlike
# sim-x86, which reaches a roscore running on the HOST at its LAN IP, and unlike
# the jetson deploy default (192.168.50.36), which advertises on the LAN for
# other machines to subscribe.
#
# Set ROS_MASTER_HOST to this machine's LAN IP instead if you want to subscribe
# to EPIC topics from another computer (rviz/rostopic on a laptop).
export ROS_MASTER_HOST="${ROS_MASTER_HOST:-localhost}"
export ROS_IP="${ROS_IP:-127.0.0.1}"
export ROS_HOSTNAME="${ROS_HOSTNAME:-localhost}"

# ── Dedicated master port (NOT the ROS default 11311) ────────────────────────
# epic-x86 is network_mode:host, so "localhost:11311" is the HOST's port 11311 —
# the very port sim-x86's roscore occupies. With the shared default,
# ensure_roscore.sh's TCP probe finds that master already up, declines to start
# EPIC's own, and every EPIC node silently registers into the sim-x86 graph
# instead. Both stacks then fight over /tf, /position_cmd and friends.
# 11312 keeps the two independent so they can run side by side on this desktop.
#
# This deliberately overrides config/stack.env's global ROS_MASTER_PORT=11311
# rather than deferring to it: stack.env is sourced FIRST and assigns the var
# unconditionally, so a "${ROS_MASTER_PORT:-...}" default here would never fire.
# Escape hatch is EPIC_ROS_MASTER_PORT — set it to 11311 when EPIC owns the
# machine (jetson deploy, real flight) or an external tool assumes the default.
export ROS_MASTER_PORT="${EPIC_ROS_MASTER_PORT:-11312}"

# ── CPU pinning: OFF for EPIC ────────────────────────────────────────────────
# config/ros_env.sh's CPUS_* map is a Jetson Orin AGX artifact: 12 cores split
# into camera(0-1) / fast-livo(2-3) / pool(4-11) to stop launch bursts from
# tripping the D435i uvc watchdog. EPIC is a LiDAR stack on a desktop/laptop —
# there is no uvc watchdog to protect, and the reserved-core split is actively
# wrong on a machine with fewer than 12 cores: `taskset -c 4-11` (what
# modules/ensure_roscore.sh applies to roscore) fails outright on an 8-core CPU,
# so roscore would never come up.
#
# Hand every core to the pool. ensure_roscore.sh keeps its `${CPUS_POOL:?}`
# assertion (fail loudly if unsourced) — this just gives it a correct value here.
export CPUS_POOL="${CPUS_POOL:-0-$(( $(nproc) - 1 ))}"
