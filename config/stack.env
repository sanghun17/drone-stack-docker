# Global config for drone-stack. Sourced by up.sh and run.sh.
# Edit paths to match the host. ${VARS} here are usable in module.yml `mounts:`.

# ROS
ROS_MASTER_PORT=11399

# Default build target arch (override per-stack via stacks/*.yml `arch:` or PLATFORM=)
DEFAULT_ARCH=arm64

# Base image (multi-arch). Heavy stages build on top.
BASE_IMAGE=ros:noetic-ros-base-focal

# --- component source repos (separate git repos, bind-mounted, NOT vendored) ---
PLANNER_SRC=/home/hmcl/risk-aware_planning-1.3      # risk_aware_planning (ml/jetson-orin-agx)
LIVO_SRC=/home/hmcl/fast_livo2_custom               # fast_livo (jetson-orin-agx)
RISK_AWARE_ASSETS=/home/hmcl/risk_aware_assets      # model weights etc.
# EPIC_SRC=...                                       # (fill when modularizing lidar-epic)
# LIVOX_DRIVER_SRC=...

# RealSense serial (blank = first device)
RS_SERIAL=
# PX4 / MAVROS FCU
FCU_URL=/dev/ttyUSB0:921600
